{
  "name": "collab-debug",
  "displayName": "CollabDebug",
  "description": "A VS Code extension for real-time collaborative debugging",
  "version": "1.0.6",
  "publisher": "aishwaryakurakula",
  "icon": "images/logo.jpg",
  "engines": {
    "vscode": "^1.74.0"
  },
  "author": {
    "name": "Aishwarya Kurakula"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/collab-and-debug/debugger-extension.git"
  },
  "categories": [
    "Debuggers"
  ],

  "activationEvents": [
    "onCommand:collabDebug.startSession",
    "onCommand:collabDebug.joinSession",
    "onCommand:collabDebug.stopSession"
  ],

  "main": "./out/extension.js",

  "contributes": {
    "commands": [
      {
        "command": "collabDebug.startSession",
        "title": "CollabDebug: Start Session"
      },
      {
        "command": "collabDebug.joinSession",
        "title": "CollabDebug: Join Session"
      },
      {
        "command": "collabDebug.stopSession",
        "title": "CollabDebug: Stop Session"
      }
    ],

    "keybindings": [
      {
        "command": "collabDebug.startSession",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "collabDebug.joinSession",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j"
      },
      {
        "command": "collabDebug.stopSession",
        "key": "ctrl+alt+x",
        "mac": "cmd+alt+x"
      }
    ]
  },

  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },

  "devDependencies": {
    "@types/node": "^16.0.0",
    "@types/vscode": "^1.74.0",
    "@types/ws": "^8.5.4",
    "typescript": "^4.9.4",
    "@vscode/vsce": "^3.2.1"
  },

  "dependencies": {
    "ws": "^8.13.0"
  }
}